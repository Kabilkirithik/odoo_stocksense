DATABASE_URL=postgresql://postgres:postgres@localhost:5432/stocksense_db
SECRET_KEY=your_secret_key_here

# AI Chatbot Configuration
# Provider: 'groq' (Cloud open-source) or 'ollama' (Local open-source)
LLM_PROVIDER=groq

# Option 1: Groq Cloud (Free API key at https://console.groq.com)
GROQ_API_KEY=gsk_your_groq_api_key_here
GROQ_MODEL=llama-3.3-70b-versatile

# Option 2: Ollama Local (e.g. ollama run llama3.1)
OLLAMA_BASE_URL=http://localhost:11434/v1
OLLAMA_MODEL=llama3.1

