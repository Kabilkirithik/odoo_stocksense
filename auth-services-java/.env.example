# ==============================================================================
# StockSense Authentication Service - Environment Configuration Template
# ==============================================================================
# Instructions:
# 1. Copy this file to '.env':
#    cp .env.example .env
# 2. Fill in your real database credentials and secret key.
# 3. DO NOT commit '.env' to git or share it publicly.
# ==============================================================================

# Database Connection (PostgreSQL)
# When running on host or remote: e.g. jdbc:postgresql://localhost:5433/stocksense_db
# When running in Docker connecting to host DB: jdbc:postgresql://host.docker.internal:5433/stocksense_db
DB_URL=jdbc:postgresql://localhost:5433/stocksense_db
DB_USERNAME=your_db_username
DB_PASSWORD=your_secure_db_password

# JWT Security Key (Minimum 256 bits / 32 characters for HMAC-SHA256)
JWT_SECRET=your_jwt_secret_key_minimum_32_characters_long!
JWT_EXPIRATION_SECONDS=86400

# Application Port
PORT=8081

# Microservice & Frontend Redirection URLs
INVENTORY_DASHBOARD_URL=http://localhost:8000/dashboard
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173,http://localhost:8000
